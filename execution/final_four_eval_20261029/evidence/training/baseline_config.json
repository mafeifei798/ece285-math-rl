{
  "experiment": "A_outcome_GRPO",
  "model_id": "Qwen/Qwen2.5-Math-1.5B",
  "seed": 17,
  "generated_token_budget": 6000000,
  "total_project_generated_token_budget": 72000000,
  "group_size": 8,
  "max_new_tokens": 2048,
  "max_prompt_tokens": 2048,
  "temperature": 1.0,
  "top_p": 1.0,
  "top_k": -1,
  "learning_rate": 0.000005,
  "lr_scheduler_type": "constant",
  "warmup_steps": 0,
  "weight_decay": 0.0,
  "max_grad_norm": 1.0,
  "beta": 0.04,
  "epsilon": 0.2,
  "loss_type": "grpo",
  "scale_rewards": "group",
  "num_iterations": 1,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 32,
  "lora_rank": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.0,
  "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "use_vllm": true,
  "vllm_gpu_memory_utilization": 0.3,
  "vllm_enable_sleep_mode": false,
  "vllm_importance_sampling_correction": false,
  "attention_implementation": "sdpa",
  "save_steps": 20,
  "save_total_limit": 3,
  "validation_size": 500,
  "split_seed": 285,
  "prompt_template": "Question: {problem}\n\nPlease reason step by step, and put your final answer within \\boxed{{}}.\nAnswer:",
  "termination": "first completed optimizer update at or above the generated-token budget; report bounded overshoot",
  "reward": "1 only for a complete, reliably parsed, mathematically equivalent final boxed answer; otherwise 0",
  "scope": "only A seed 17 is authorized for initial launch; B/C/D and additional seeds are not queued"
}
